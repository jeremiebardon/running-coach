# --- data source ---
# "intervals" (default) or "fixtures" (recorded demo athlete, no API key needed)
DATA_SOURCE=intervals
# intervals.icu → Settings → Developer → API key. Auth = Basic "API_KEY:<key>"
INTERVALS_API_KEY=
# "0" means "the owner of the API key"
INTERVALS_ATHLETE_ID=0
ATHLETE_TIMEZONE=America/Toronto

# --- models: "provider:model" ---
# Local (default): ollama pull qwen3:14b — any Ollama model with tool calling works
COACH_MODEL=ollama:qwen3:14b
JUDGE_MODEL=ollama:qwen3:14b
OLLAMA_BASE_URL=http://localhost:11434
# Claude instead: COACH_MODEL=anthropic:claude-sonnet-5-5 · JUDGE_MODEL=anthropic:claude-haiku-4-5
# ANTHROPIC_API_KEY=

# --- Phoenix ---
# Local: docker compose up -d phoenix
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_HOST=http://localhost:6006
PHOENIX_PROJECT=running-coach
# Only for Phoenix Cloud / authenticated self-hosted
# PHOENIX_API_KEY=
